  "mission_text": [
    {
      "id": 9077,
      "title": "Attack of the Killer Animals",
      "description": "Help people in \"Town%\"004 fight back against the animals."
    },
    {
      "id": 9078,
      "title": "Return Home",
      "description": "Tell \"AdvNPC%\"002 that supplies will be there soon."
    },
    {
      "id": 9079,
      "title": "Early Transportation",
      "description": "Go ask \"AdvNPC%\"005 about transportation."
    }
  ],
  "dialogue": [
    {
      "id": 4107,
      "npc_token": -9897,
      "role": 4,
      "localization_id": 3004107,
      "text": "We have incoming! A pack of monsters is coming right for our town!"
    },
    {
      "id": 4108,
      "npc_token": -9898,
      "role": 3,
      "localization_id": 3004108,
      "text": "\"name%\", I thought you got them all?! Are they here for revenge?"
    },
    {
      "id": 4109,
      "npc_token": -9897,
      "role": 4,
      "localization_id": 3004109,
      "text": "Whatever the case, they're gonna be on us soon!"
    },
    {
      "id": 4110,
      "npc_token": -9898,
      "role": 3,
      "localization_id": 3004110,
      "text": "Everyone get ready to fight!"
    },
    {
      "id": 4111,
      "npc_token": -9999,
      "role": 0,
      "localization_id": 3004111,
      "text": "Everyone okay?"
    },
    {
      "id": 4112,
      "npc_token": -9898,
      "role": 3,
      "localization_id": 3004112,
      "text": "Yeah. Hopefully we've seen the last of 'em. We'll go out to our mines and start our work again, tell \"AdvNPC%\"002 that the materials will be there soon!"
    },
    {
      "id": 4113,
      "npc_token": -9999,
      "role": 0,
      "localization_id": 3004113,
      "text": "The materials will be here soon!"
    },
    {
      "id": 4114,
      "npc_token": -9899,
      "role": 2,
      "localization_id": 3004114,
      "text": "Good job! While yer gone, we fixed up some of the basic colony scripts for ya. Here ya go. Now you just need to replicate them and start building your settlement! Simple task, haha. When the new materials come, I'll have more scripts ready for you."
    },
    {
      "id": 4115,
      "npc_token": -9899,
      "role": 2,
      "localization_id": 3004115,
      "text": "The colony areas are some distance from here, ya might wanna talk with \"AdvNPC%\"005 for getting' a ride!"
    }
  ],
